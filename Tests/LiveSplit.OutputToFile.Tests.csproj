<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>LiveSplit.UI.Components.OutputToFile.Tests</RootNamespace>
    <!-- LiveSplit's folder, as in the component's csproj: set it with -p:LiveSplitDir=<folder> or a LiveSplitDir environment variable -->
    <LiveSplitDir Condition=" '$(LiveSplitDir)' == '' ">$(MSBuildProjectDirectory)\..\..\..\Programs\Streaming\LiveSplit</LiveSplitDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Copied into the output, unlike the component's references: the tests run outside LiveSplit -->
    <Reference Include="LiveSplit.Core">
      <HintPath>$(LiveSplitDir)\LiveSplit.Core.dll</HintPath>
    </Reference>
    <Reference Include="SpeedrunComSharp">
      <HintPath>$(LiveSplitDir)\SpeedrunComSharp.dll</HintPath>
    </Reference>
    <Reference Include="UpdateManager">
      <HintPath>$(LiveSplitDir)\UpdateManager.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <ProjectReference Include="..\LiveSplit.OutputToFile.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
